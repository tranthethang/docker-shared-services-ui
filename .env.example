# Required: absolute host path to the docker-shared-services repository
DSS_REPO_PATH=/path/to/docker-shared-services

# Routing and stack naming (must match docker-shared-services)
DOMAIN=sandbox.localhost
SANDBOX_NAME=sandbox

# Optional Traefik auth middleware (e.g. basic-auth@file or forward-auth@file)
AUTH_MIDDLEWARE=

# Container lifecycle and resource limits
RESTART_POLICY=unless-stopped
CONSOLE_CPUS_LIMIT=0.50
CONSOLE_MEMORY_LIMIT=128M
